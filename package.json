{
  "name": "poney",
  "productName": "Poney",
  "version": "0.1.0",
  "description": "Desktop coding agent built for small local models (Ollama, LM Studio, llama.cpp).",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "node scripts/brand-electron.ts && npm run build && electron .",
    "build": "node scripts/build.ts",
    "cli": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^20.19.43",
    "electron": "^33.2.1",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.314",
    "@highlightjs/cdn-assets": "^11.12.0",
    "@lmstudio/sdk": "^2.1.0",
    "dompurify": "^3.1.6",
    "katex": "^0.16.11",
    "marked": "^12.0.2",
    "socks-proxy-agent": "^8.0.5"
  }
}
